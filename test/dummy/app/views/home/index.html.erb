<% dummy_page_nav(title: "YouTube search", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "YouTube search",
    subtitle: "Search public YouTube videos, channels, and playlists.",
    variant: :h1
  ) %>

  <%= form_with url: root_path, method: :get, class: "flex w-full flex-col gap-3 sm:flex-row sm:items-end" do %>
    <div class="min-w-0 flex-1">
      <%= render FlatPack::SearchInput::Component.new(
        name: "q",
        value: @query,
        label: "Search",
        placeholder: "Search YouTube"
      ) %>
    </div>
    <%# An empty name keeps Rails from adding button= to the query string. %>
    <%= render FlatPack::Button::Component.new(
      text: "Search",
      style: :primary,
      type: "submit",
      name: ""
    ) %>
  <% end %>

  <% if @error.present? %>
    <%= render FlatPack::Alert::Component.new(description: @error, style: :danger) %>
  <% elsif @results.nil? %>
    <p class="text-sm leading-6 text-(--surface-muted-content-color)">Enter a search to see public YouTube results.</p>
  <% elsif @results.items.empty? %>
    <p class="text-sm leading-6">No results for <%= @query %>.</p>
  <% else %>
    <% summary = "#{@results.items.size} #{"result".pluralize(@results.items.size)}" %>
    <% summary = "#{summary} of #{number_with_delimiter(@results.total_results)}" if @results.total_results %>
    <p class="text-sm leading-6 text-(--surface-muted-content-color)"><%= summary %></p>

    <div class="flex flex-col gap-4">
      <% @results.items.each do |item| %>
        <%= render "result", item: item %>
      <% end %>
    </div>

    <% if @results.previous_page_token.present? || @results.more? %>
      <div class="flex gap-3">
        <% if @results.previous_page_token.present? %>
          <%= render FlatPack::Button::Component.new(
            text: "Previous",
            style: :secondary,
            href: root_path(q: @query, page_token: @results.previous_page_token)
          ) %>
        <% end %>
        <% if @results.more? %>
          <%= render FlatPack::Button::Component.new(
            text: "Next",
            style: :secondary,
            href: root_path(q: @query, page_token: @results.next_page_token)
          ) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
